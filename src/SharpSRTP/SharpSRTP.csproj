<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net481;net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\SharpDTLS\src\SharpDTLS\SharpDTLS.csproj" />
  </ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' OR '$(TargetFramework)' == 'net481'">
		<PackageReference Include="System.Memory" Version="4.6.3" />
	</ItemGroup>

	<!-- the public API: listed in PublicAPI.*.txt, and checked against the last release (doc/public-api.md) -->
	<!-- what every target framework offers is in PublicAPI.*.txt here, what only some do in PublicAPI\<framework>\ -->
	<ItemGroup>
		<AdditionalFiles Include="PublicAPI\$(TargetFramework)\PublicAPI.Shipped.txt" />
		<AdditionalFiles Include="PublicAPI\$(TargetFramework)\PublicAPI.Unshipped.txt" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="all" />
	</ItemGroup>

	<PropertyGroup>
		<WarningsAsErrors>$(WarningsAsErrors);RS0016;RS0017</WarningsAsErrors>
		<!-- overloads with optional parameters are a style choice here, not a break -->
		<NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
		<EnablePackageValidation>true</EnablePackageValidation>
		<PackageValidationBaselineVersion>0.5.8</PackageValidationBaselineVersion>
	</PropertyGroup>

</Project>
